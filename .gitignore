# ===== 监理总控工作台（Windows 桌面版）仓库忽略规则 =====

# 依赖（electron / electron-builder 等，体积大，install 即可恢复）
node_modules/

# 构建产物 / 打包输出
# dist/ 为 electron-builder 中间与最终输出；dist_release/ 含便携版 exe
# exe 通过 GitHub Releases 发布，不进代码树
dist/
dist_release/
build/
release/
win-unpacked/
*.exe

# 备份文件（开发过程留痕，非源码）
*_备份_*.html
*_备份_*.js

# 网页版相关（本仓库只收录桌面版，剔除网页端文件）
inline_echarts.js
mammoth.browser.min.js
*.bat

# 运行时进程 id
*.pid

# 本地数据目录（用户运行时生成，含业务 JSON）
data/

# 编辑器 / 系统临时
.DS_Store
Thumbs.db
*.tmp

# iOS 独立仓库（单独管理，不纳入电脑端仓库）
jianli_ios/

# Flutter 误判项目（非电脑端实际代码）
jianli_app/

# 临时开发脚本与输出
check-*.js
gh_*.py
gh_*.json
make_*.py
ssh-*.js
test_p12.py
gn_out.txt
mr_out.txt
uploaded.txt
style.json
build_v*.log

# 临时参考图片
ref_*.png
tmp_ref*.png
wf_ref_*.png

# IPA 与打包中间产物
ipa/
ipa-artifact.zip
*.ipa

# 运行日志
runlog/
runlog*/
runlog*.zip

# UI 设计运行产物
ui-design-runs/
preview/
wireframes.html

# 服务器备份与私有证书
server-backup/
signing_private/

# 设计文档（非源码）
docs/

# 压缩包
*.rar
*.zip

# 根目录临时图标（正式图标在 build/ 下）
/icon.ico
/icon_1024.png

# 临时 JSON
repo_payload.json

# 空目录
server/
