{
  "name": "jianli-workbench",
  "version": "1.3.0",
  "description": "监理总控工作台 —— 本地业务管理 + 华为服务器云同步（Node.js + SQLite）",
  "main": "main.js",
  "author": "ZGX",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --win dir",
    "dist": "node build.js",
    "dist:nsi": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.jianli.workbench",
    "productName": "监理总控工作台",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "app.html",
      "docxgen.js",
      "build/icon.ico"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "jianli-workbench-v${version}-setup.${ext}",
      "requestedExecutionLevel": "asInvoker",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "监理总控工作台",
      "artifactName": "监理总控工作台-v${version}-setup.${ext}"
    }
  }
}
